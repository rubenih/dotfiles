[
  {
    "layer": "top",
    "position": "top",
    "height": 38,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/notifications", "network", "custom/net_top"],

    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate"
    },

    "network": {
      "interval": 5,
      "format-wifi": "  {essid}",
      "format-ethernet": "󰈀  {ipaddr}",
      "format-disconnected": "⚠ offline"
    },

    "custom/net_top": {
      "exec": "~/.config/waybar/net.sh",
      "interval": 2
    },

    "custom/notifications": {
      "exec": "~/.config/waybar/notifications.sh",
      "return-type": "json",
      "on-click": "swaync-client -t",
      "on-click-right": "swaync-client -d",
      "interval": 2
    }
  },

  {
    "layer": "top",
    "position": "bottom",
    "height": 38,

    "modules-left": ["network", "cpu", "memory"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "battery", "tray"],

    "cpu": {
      "interval": 2,
      "format": " {usage}%"
    },

    "memory": {
      "interval": 2,
      "format": " {used}GB"
    },

    "clock": {
      "format": " {:%H:%M | %d/%m}",
      "tooltip-format": "{:%A, %d %B %Y}"
    },

    "pulseaudio": {
      "format": " {volume}%",
      "format-muted": " muted"
    },

    "battery": {
      "format": " {capacity}%",
      "states": {
        "warning": 30,
        "critical": 15
      }
    }
  }
]
